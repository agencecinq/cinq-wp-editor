#. Plugin Name of the plugin
#: cinq-wp-editor.php
msgid "CINQ Editor"
msgstr "CINQ Éditeur"

#. Plugin URI of the plugin
#: cinq-wp-editor.php
msgid "https://github.com/agencecinq/cinq-wp-editor"
msgstr ""

#. Description of the plugin
#: cinq-wp-editor.php
msgid "Edits the ACF blocks of a page on one screen: the list of blocks, a live preview of the real site and the settings of the selected block."
msgstr "Édite les blocs ACF d’une page sur un seul écran : la liste des blocs, l’aperçu en direct du vrai site et les réglages du bloc sélectionné."

#. Author of the plugin
#: cinq-wp-editor.php
msgid "CINQ"
msgstr ""

#. Author URI of the plugin
#: cinq-wp-editor.php
msgid "https://agencecinq.com/"
msgstr ""

