{#
 # One block, alone, in its preview marker
 #
 # What `blocks/blocks.html.twig` renders for each block, for the REST route
 # that sends the editor the blocks that changed.
 #
 # @package CinqWpEditor
 #}

<div data-cinq-block="{{ index }}" style="display: contents">
	{{-
		include(
			"blocks/#{ block.acf_fc_layout | lower | replace( { '_': '-' } ) }.html.twig",
			{
				block: block,
				loop: index,
				classes: [ 'block-index-' ~ index ],
			},
			ignore_missing: true
		)
	-}}
</div>
