{
	"name": "agencecinq/cinq-wp-editor",
	"description": "Edits the ACF blocks of a page on one screen, with a live preview of the real site.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"i18n": [
			"wp i18n make-pot . languages/cinq-wp-editor.pot --exclude=build,bin,node_modules,vendor,.sandbox --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/agencecinq/cinq-wp-editor/issues\"}'",
			"wp i18n update-po languages/cinq-wp-editor.pot",
			"wp i18n make-mo languages",
			"wp i18n make-json languages --no-purge --use-map='{\"src/editor.js\":\"build/editor.js\",\"assets/preview.js\":\"assets/preview.js\"}'"
		]
	}
}
